{
  "name": "threadvault",
  "version": "0.1.0",
  "description": "Local-first archive and search for AI coding conversations.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyh/threadvault.git"
  },
  "bugs": {
    "url": "https://github.com/wyh/threadvault/issues"
  },
  "homepage": "https://github.com/wyh/threadvault#readme",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "scan": "node src/server.js --scan-only",
    "prepare:extension": "node scripts/prepare-extension.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:publish": "node scripts/verify.mjs --publish",
    "package:vsix": "npm --prefix extension run package:vsix",
    "publish:vsce": "npm --prefix extension run publish:vsce"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
